<ui:FluentWindow x:Class="RG477MToolkit.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:RG477MToolkit.Controls"
                 Title="RG477M Root &amp; Performance Toolkit"
                 Width="1060"
                 Height="755"
                 MinWidth="940"
                 MinHeight="660"
                 Icon="pack://application:,,,/Assets/app.ico"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0"
                     Title="RG477M Root &amp; Performance Toolkit"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Основная рабочая область -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: живой рендер RG477M + статус + гайд подключения -->
                <StackPanel Grid.Column="0">
                    <ui:Card Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DeviceCardTitleText" Text="Состояние консоли" FontSize="15" FontWeight="SemiBold"/>
                                <Border x:Name="StatusBadge"
                                        Grid.Column="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Background="#27272A">
                                    <TextBlock x:Name="StatusBadgeText"
                                               Text="Поиск..."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#A1A1AA"/>
                                </Border>
                            </Grid>

                            <controls:Rg477mDeviceCanvas x:Name="DeviceCanvas" HorizontalAlignment="Center" Margin="0,2,0,10"/>

                            <TextBlock x:Name="ModeDetailText"
                                       Text="Подключите RG477M по USB-C"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#D4D4D8"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock x:Name="LabelFirmwareCaption" Text="Прошивка" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="FirmwareText" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="LabelSlotCaption" Text="Активный слот" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="SlotText" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="LabelMagiskCaption" Text="Magisk" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="MagiskText" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock x:Name="LabelBackupCaption" Text="Сток-бэкап" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="BackupText" Text="Проверка..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Карточка подсказки по режимам подключения -->
                    <ui:Card Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="GuideTitleText" Text="Памятка подключения (MT6897)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="GuideAdbText"
                                       Text="• Обычный режим (ADB): включите отладку по USB на консоли и подключите кабель."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="GuidePreloaderText"
                                       Text="• Авто-Preloader (рекомендуется): при бэкапе, прошивке и откате по ADB консоль сама перезагрузится и подхватится SP Flash Tool без зажатия кнопок."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ui:Button x:Name="BtnRebootPreloader"
                                       Content="Перезагрузить в Preloader / BROM (ADB)"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,2,0,0"
                                       IsEnabled="False"
                                       ToolTipService.InitialShowDelay="250"
                                       ToolTipService.ShowDuration="15000"
                                       Click="BtnRebootPreloader_Click"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Правая колонка: Пошаговый мастер -->
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WizardTitleText" Text="Мастер установки и оптимизации" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ToolkitSubtitleText"
                                       Text="Anbernic RG477M • Stock V1.32 • Magisk v31.1"
                                       FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="DriverOkBadge"
                                    CornerRadius="6"
                                    Padding="9,5"
                                    Margin="0,0,8,0"
                                    Background="#14532D"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DriverOkBadgeText"
                                           Text="Драйверы: OK"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#86EFAC"/>
                            </Border>
                            <ui:Button x:Name="BtnLangToggle"
                                       Content="EN"
                                       Padding="12,6"
                                       ToolTipService.InitialShowDelay="250"
                                       ToolTipService.ShowDuration="15000"
                                       Click="BtnLangToggle_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Баннер автодетекта драйверов (показывается только если драйверы НЕ установлены) -->
                    <ui:Card x:Name="DriverBanner"
                             Padding="12"
                             Margin="0,0,0,12"
                             BorderBrush="#B45309"
                             BorderThickness="1"
                             Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="DriverBannerTitle"
                                           Text="Требуются драйверы MediaTek VCOM / ADB"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FBBF24"/>
                                <TextBlock x:Name="DriverBannerDesc"
                                           Text="Драйверы не найдены в системе. Установите их один раз для работы Readback и прошивки."
                                           FontSize="11"
                                           Foreground="#D4D4D8"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:Button x:Name="BtnInstallDrivers"
                                       Grid.Column="1"
                                       Content="Установить драйверы"
                                       Appearance="Primary"
                                       VerticalAlignment="Center"
                                       ToolTipService.InitialShowDelay="250"
                                       ToolTipService.ShowDuration="15000"
                                       Click="BtnInstallDrivers_Click"/>
                        </Grid>
                    </ui:Card>

                    <!-- Шаг 1: Бэкап стока -->
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="Step1TitleText" Text="1. Резервная копия заводской прошивки (бэкап)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Step1DescText"
                                       Text="Сохраняет заводские системные разделы на компьютер с проверкой SHA-256. Ничего не меняет на консоли и нужен для безопасного отката."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnReadbackRun"
                                           Content="Снять бэкап"
                                           Appearance="Primary"
                                           ToolTipService.InitialShowDelay="250"
                                           ToolTipService.ShowDuration="15000"
                                           Click="BtnReadbackRun_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Шаг 2: Патч и прошивка Magisk -->
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="Step2TitleText" Text="2. Установка root-доступа Magisk v31.1 (без сброса данных)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Step2DescText"
                                       Text="Автоматически подготовит патч из вашего бэкапа и установит Magisk без удаления игр, сохранений и настроек."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnFlashMagisk"
                                           Content="Установить Magisk"
                                           Appearance="Primary"
                                           ToolTipService.InitialShowDelay="250"
                                           ToolTipService.ShowDuration="15000"
                                           Click="BtnFlashMagisk_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Шаг 3: Модуль оптимизации -->
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="Step3TitleText" Text="3. Модуль оптимизации RG477M (FPS, кулер, звук, экран)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Step3DescText"
                                       Text="Стабильные 60 FPS в «Балансе», меньше нагрева в «Игровом», тихий плавный вентилятор, без мерцаний экрана и щелчков динамиков. Термозащита остаётся включённой."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnInstallPerfModule"
                                           Content="Установить модуль"
                                           Appearance="Primary"
                                           Margin="0"
                                           ToolTipService.InitialShowDelay="250"
                                           ToolTipService.ShowDuration="15000"
                                           Click="BtnInstallPerfModule_Click"/>
                                <ui:Button x:Name="BtnUninstallPerfModule"
                                           Content="Удалить"
                                           Margin="8,0,0,0"
                                           Visibility="Collapsed"
                                           ToolTipService.InitialShowDelay="250"
                                           ToolTipService.ShowDuration="15000"
                                           Click="BtnUninstallPerfModule_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Шаг 4: Аварийный откат -->
                    <ui:Card Padding="16" BorderBrush="#7F1D1D" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock x:Name="Step4TitleText" Text="Откат на чистый сток V1.32" FontSize="14" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                                <TextBlock x:Name="Step4DescText"
                                           Text="Возвращает заводские системные разделы из вашей резервной копии и полностью удаляет root (Magisk). Игры и файлы сохранятся."
                                           FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnRestoreStock"
                                           Content="Откатить на сток"
                                           Appearance="Danger"
                                           ToolTipService.InitialShowDelay="250"
                                           ToolTipService.ShowDuration="15000"
                                           Click="BtnRestoreStock_Click"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя скрываемая консоль логов -->
        <Expander x:Name="LogExpander"
                  Grid.Row="2"
                  Margin="20,0,20,14"
                  IsExpanded="False"
                  Header="Консоль операций (нажмите, чтобы развернуть)">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="LogTextBox"
                         Grid.Row="0"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#09090B"
                         Foreground="#E4E4E7"
                         Padding="10"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <ui:Button x:Name="BtnCopyLog"
                               Content="Копировать лог"
                               Margin="0,0,8,0"
                               ToolTipService.InitialShowDelay="250"
                               ToolTipService.ShowDuration="15000"
                               Click="BtnCopyLog_Click"/>
                    <ui:Button x:Name="BtnClearLog"
                               Content="Очистить"
                               ToolTipService.InitialShowDelay="250"
                               ToolTipService.ShowDuration="15000"
                               Click="BtnClearLog_Click"/>
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</ui:FluentWindow>
