<ui:FluentWindow x:Class="RG477MToolkit.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:RG477MToolkit.Controls"
                 Title="RG477M Root &amp; Performance Toolkit"
                 Width="1060"
                 Height="755"
                 MinWidth="940"
                 MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0"
                     Title="RG477M Root &amp; Performance Toolkit"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <!-- Основная рабочая область -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: живой рендер RG477M + статус + гайд подключения -->
                <StackPanel Grid.Column="0">
                    <ui:Card Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DeviceCardTitleText" Text="Состояние консоли" FontSize="15" FontWeight="SemiBold"/>
                                <Border x:Name="StatusBadge"
                                        Grid.Column="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Background="#27272A">
                                    <TextBlock x:Name="StatusBadgeText"
                                               Text="Поиск..."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#A1A1AA"/>
                                </Border>
                            </Grid>

                            <controls:Rg477mDeviceCanvas x:Name="DeviceCanvas" HorizontalAlignment="Center" Margin="0,2,0,10"/>

                            <TextBlock x:Name="ModeDetailText"
                                       Text="Подключите RG477M по USB-C"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#D4D4D8"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock x:Name="LabelFirmwareCaption" Text="Прошивка" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="FirmwareText" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="LabelSlotCaption" Text="Активный слот" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="SlotText" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="LabelMagiskCaption" Text="Magisk" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="MagiskText" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock x:Name="LabelBackupCaption" Text="Сток-бэкап" FontSize="11" Foreground="#71717A"/>
                                    <TextBlock x:Name="BackupText" Text="Проверка..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Карточка подсказки по режимам подключения -->
                    <ui:Card Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="GuideTitleText" Text="Памятка подключения (MT6897)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="GuideAdbText"
                                       Text="• Обычный режим (ADB): включите отладку по USB на консоли и подключите кабель."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="GuidePreloaderText"
                                       Text="• Авто-Preloader (рекомендуется): при запуске прошивки по ADB консоль сама перезагрузится и подхватится SP Flash Tool без зажатия кнопок."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="GuideBromText"
                                       Text="• Ручной BROM (если не загружается): полностью выключите консоль, зажмите Vol+ и Vol- (НЕ нажимайте Power!) и вставьте USB-C."
                                       FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Правая колонка: Пошаговый мастер -->
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WizardTitleText" Text="Мастер установки и оптимизации" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ToolkitSubtitleText"
                                       Text="Anbernic RG477M • Stock V1.32 • Magisk v31.1"
                                       FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="DriverOkBadge"
                                    CornerRadius="6"
                                    Padding="9,5"
                                    Margin="0,0,8,0"
                                    Background="#14532D"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DriverOkBadgeText"
                                           Text="Драйверы: OK"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#86EFAC"/>
                            </Border>
                            <ui:Button x:Name="BtnLangToggle"
                                       Content="EN"
                                       Padding="12,6"
                                       Click="BtnLangToggle_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Баннер автодетекта драйверов (показывается только если драйверы НЕ установлены) -->
                    <ui:Card x:Name="DriverBanner"
                             Padding="12"
                             Margin="0,0,0,12"
                             BorderBrush="#B45309"
                             BorderThickness="1"
                             Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="DriverBannerTitle"
                                           Text="Требуются драйверы MediaTek VCOM / ADB"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FBBF24"/>
                                <TextBlock x:Name="DriverBannerDesc"
                                           Text="Драйверы не найдены в системе. Установите их один раз для работы Readback и прошивки."
                                           FontSize="11"
                                           Foreground="#D4D4D8"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:Button x:Name="BtnInstallDrivers"
                                       Grid.Column="1"
                                       Content="Установить драйверы"
                                       Appearance="Primary"
                                       VerticalAlignment="Center"
                                       Click="BtnInstallDrivers_Click"/>
                        </Grid>
                    </ui:Card>

                    <!-- Шаг 1: Бэкап стока -->
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="Step1TitleText" Text="1. Readback-бэкап стоковых разделов" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Step1DescText"
                                       Text="Сохраняет boot, init_boot, vbmeta, preloader (A/B) и seccfg с проверкой SHA-256 перед любыми изменениями."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnReadbackDryRun" Content="Генерация XML" Margin="0,0,8,0" Click="BtnReadbackDryRun_Click"/>
                                <ui:Button x:Name="BtnReadbackRun" Content="Снять бэкап" Appearance="Primary" Click="BtnReadbackRun_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Шаг 2: Патч и прошивка Magisk -->
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="Step2TitleText" Text="2. Патч и установка Magisk v31.1 (без сброса данных)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Step2DescText"
                                       Text="Патчит родной init_boot с headless-настройкой и подписывает vbmeta тем же AOSP testkey для заблокированного загрузчика."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnPatchMagisk" Content="Собрать патч" Margin="0,0,8,0" Click="BtnPatchMagisk_Click"/>
                                <ui:Button x:Name="BtnFlashDryRun" Content="Dry-Run прошивки" Margin="0,0,8,0" Click="BtnFlashDryRun_Click"/>
                                <ui:Button x:Name="BtnFlashMagisk" Content="Прошить Magisk" Appearance="Primary" Click="BtnFlashMagisk_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Шаг 3: Модуль производительности -->
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="Step3TitleText" Text="3. Модуль производительности GPU/CPU (Баланс / Игровой)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Step3DescText"
                                       Text="Снимает лимит 900 МГц в Балансе, ускоряет GED-буст Mali-G615 и убирает 1-сек мерцания SurfaceFlinger при сохранении термозащиты."
                                       FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnBuildModule" Content="Собрать ZIP" Margin="0,0,8,0" Click="BtnBuildModule_Click"/>
                                <ui:Button x:Name="BtnModuleDryRun" Content="Dry-Run" Margin="0,0,8,0" Click="BtnModuleDryRun_Click"/>
                                <ui:Button x:Name="BtnInstallPerfModule" Content="Установить модуль" Appearance="Primary" Margin="0,0,8,0" Click="BtnInstallPerfModule_Click"/>
                                <ui:Button x:Name="BtnUninstallPerfModule" Content="Удалить" Click="BtnUninstallPerfModule_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Шаг 4: Аварийный откат -->
                    <ui:Card Padding="16" BorderBrush="#7F1D1D" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock x:Name="Step4TitleText" Text="Откат на чистый сток V1.32" FontSize="14" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                                <TextBlock x:Name="Step4DescText"
                                           Text="Возвращает оригинальные vbmeta и init_boot из локального Readback-бэкапа в 1 клик."
                                           FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnRestoreDryRun" Content="Dry-Run" Margin="0,0,8,0" Click="BtnRestoreDryRun_Click"/>
                                <ui:Button x:Name="BtnRestoreStock" Content="Откатить на сток" Appearance="Danger" Click="BtnRestoreStock_Click"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя скрываемая консоль логов -->
        <Expander x:Name="LogExpander"
                  Grid.Row="2"
                  Margin="20,0,20,14"
                  IsExpanded="False"
                  Header="Консоль операций (нажмите, чтобы развернуть)">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="LogTextBox"
                         Grid.Row="0"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#09090B"
                         Foreground="#E4E4E7"
                         Padding="10"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <ui:Button x:Name="BtnCopyLog" Content="Копировать лог" Margin="0,0,8,0" Click="BtnCopyLog_Click"/>
                    <ui:Button x:Name="BtnClearLog" Content="Очистить" Click="BtnClearLog_Click"/>
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</ui:FluentWindow>
