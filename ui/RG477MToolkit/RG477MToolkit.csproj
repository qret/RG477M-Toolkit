    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>RG477M Root &amp; Performance Toolkit</ApplicationTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
