<UserControl x:Class="RG477MToolkit.Controls.Rg477mDeviceCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="230"
             Width="420">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Canvas Width="420" Height="230">
                <!-- Подсветка / свечение под корпусом -->
                <Border x:Name="ChassisGlowBorder"
                        Canvas.Left="24"
                        Canvas.Top="24"
                        Width="372"
                        Height="178"
                        CornerRadius="28"
                        Background="#121418">
                    <Border.Effect>
                        <DropShadowEffect x:Name="ChassisGlowEffect"
                                          Color="#3F3F46"
                                          BlurRadius="26"
                                          ShadowDepth="0"
                                          Opacity="0.65"/>
                    </Border.Effect>
                </Border>

                <!-- Шифты L1 / L2 и R1 / R2 -->
                <Border Canvas.Left="46" Canvas.Top="17" Width="54" Height="10" CornerRadius="4" Background="#2E323B"/>
                <Border Canvas.Left="320" Canvas.Top="17" Width="54" Height="10" CornerRadius="4" Background="#2E323B"/>

                <!-- Кнопки громкости Vol+ / Vol- (верхний торец слева) -->
                <Border x:Name="VolUpButton" Canvas.Left="114" Canvas.Top="18" Width="28" Height="7" CornerRadius="3" Background="#3F4552"/>
                <Border x:Name="VolDownButton" Canvas.Left="146" Canvas.Top="18" Width="28" Height="7" CornerRadius="3" Background="#3F4552"/>
                <TextBlock x:Name="VolHintLabel"
                           Canvas.Left="104"
                           Canvas.Top="2"
                           Text="Vol+ / Vol-"
                           Foreground="#71717A"
                           FontSize="10"
                           FontWeight="SemiBold"/>

                <!-- Кнопка Power (верхний торец справа) -->
                <Border x:Name="PowerButton" Canvas.Left="280" Canvas.Top="18" Width="24" Height="7" CornerRadius="3" Background="#3F4552"/>
                <TextBlock x:Name="PowerHintLabel"
                           Canvas.Left="276"
                           Canvas.Top="2"
                           Text="Power"
                           Foreground="#52525B"
                           FontSize="10"/>

                <!-- Основной металлический корпус RG477M -->
                <Border x:Name="BodyShell"
                        Canvas.Left="24"
                        Canvas.Top="24"
                        Width="372"
                        Height="178"
                        CornerRadius="26"
                        BorderThickness="2"
                        BorderBrush="#3A3F4B">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#272A32" Offset="0"/>
                            <GradientStop Color="#1C1E24" Offset="0.5"/>
                            <GradientStop Color="#15171C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Экран 4:3 по центру -->
                <Border x:Name="ScreenBezel"
                        Canvas.Left="104"
                        Canvas.Top="36"
                        Width="212"
                        Height="154"
                        CornerRadius="10"
                        Background="#0A0B0E"
                        BorderThickness="1.5"
                        BorderBrush="#323741">
                    <Grid Margin="6">
                        <Border x:Name="ScreenDisplay"
                                CornerRadius="6"
                                Background="#0D1117">
                            <StackPanel VerticalAlignment="Center" Margin="8">
                                <TextBlock x:Name="ScreenTitle"
                                           Text="RG477M"
                                           Foreground="#E4E4E7"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="ScreenSubtitle"
                                           Text="Ожидание USB..."
                                           Foreground="#71717A"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="ScreenMeta"
                                           Text="MT6897 • Stock V1.32"
                                           Foreground="#52525B"
                                           FontSize="10"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Левая часть: D-Pad -->
                <Grid Canvas.Left="46" Canvas.Top="56" Width="38" Height="38">
                    <Border Width="12" Height="38" CornerRadius="3" Background="#2F333D" BorderBrush="#454B59" BorderThickness="1"/>
                    <Border Width="38" Height="12" CornerRadius="3" Background="#2F333D" BorderBrush="#454B59" BorderThickness="1"/>
                </Grid>

                <!-- Левый стик -->
                <Ellipse Canvas.Left="48" Canvas.Top="120" Width="34" Height="34" Fill="#1E2128" Stroke="#454B59" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="54" Canvas.Top="126" Width="22" Height="22" Fill="#2D313B"/>

                <!-- Правая часть: ABXY -->
                <Grid Canvas.Left="334" Canvas.Top="54" Width="44" Height="44">
                    <Ellipse Canvas.Left="15" Canvas.Top="0" Width="13" Height="13" Fill="#2F333D" Stroke="#4B5563" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="15" Canvas.Top="30" Width="13" Height="13" Fill="#2F333D" Stroke="#4B5563" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="0" Canvas.Top="15" Width="13" Height="13" Fill="#2F333D" Stroke="#4B5563" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="30" Canvas.Top="15" Width="13" Height="13" Fill="#2F333D" Stroke="#4B5563" StrokeThickness="1"/>
                </Grid>

                <!-- Правый стик -->
                <Ellipse Canvas.Left="338" Canvas.Top="120" Width="34" Height="34" Fill="#1E2128" Stroke="#454B59" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="344" Canvas.Top="126" Width="22" Height="22" Fill="#2D313B"/>

                <!-- Служебные кнопки (Select/Start/Function) -->
                <Ellipse Canvas.Left="88" Canvas.Top="162" Width="8" Height="8" Fill="#2D313B"/>
                <Ellipse Canvas.Left="324" Canvas.Top="162" Width="8" Height="8" Fill="#2D313B"/>

                <!-- Нижний порт USB-C -->
                <Border x:Name="UsbPort"
                        Canvas.Left="195"
                        Canvas.Top="200"
                        Width="30"
                        Height="6"
                        CornerRadius="3"
                        Background="#3F4552"/>
                <TextBlock x:Name="UsbLabel"
                           Canvas.Left="189"
                           Canvas.Top="209"
                           Text="USB-C"
                           Foreground="#71717A"
                           FontSize="10"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
